# SQLite Configuration (Default Local Development)
DATABASE_URL="file:./spis.db"

# PostgreSQL Configuration (Production & Scaled Multi-School Deployment)
# DATABASE_URL="postgresql://spis_user:secure_password@localhost:5432/spis_db?schema=public"

# JWT Secret
JWT_SECRET="replace-with-a-very-long-random-secret-key"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=4000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
